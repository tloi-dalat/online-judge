#, python-format
msgid "Revoked %d refresh token."
msgid_plural "Revoked %d refresh tokens."
msgstr[0] "Đã thu hồi %d mã làm mới."

#: oauth2_provider/forms.py
msgid ""
"The client secret is hashed and can no longer be viewed. To rotate it, enter "
"a new value and copy it before saving; the original secret cannot be "
"recovered."
msgstr ""
"Khoá bí mật của ứng dụng đã được băm và không thể xem lại. Để đổi khoá, hãy "
"nhập giá trị mới và sao chép nó trước khi lưu; khoá cũ không thể khôi phục."

#: oauth2_provider/forms.py
msgid ""
"Copy and store this secret now. Once saved, it will be hashed and cannot be "
"recovered."
msgstr ""
"Hãy sao chép và lưu khoá bí mật này ngay. Sau khi lưu, khoá sẽ được băm và "
"không thể khôi phục."

#: oauth2_provider/forms.py
msgid ""
"This application stores its client secret unhashed, so the value above "
"remains usable. Entering a new value replaces it."
msgstr ""
"Ứng dụng này lưu khoá bí mật dạng chưa băm, nên giá trị ở trên vẫn dùng "
"được. Nhập giá trị mới sẽ thay thế nó."

#: oauth2_provider/forms.py
msgid ""
"Copy and store this secret now. This application stores the secret unhashed."
msgstr ""
"Hãy sao chép và lưu khoá bí mật này ngay. Ứng dụng này lưu khoá bí mật dạng "
"chưa băm."

#: oauth2_provider/forms.py
msgid ""
"HS256 signs tokens with the client secret as the HMAC key, so the secret "
"must be stored unhashed. Uncheck “Hash client secret” and set an unhashed "
"client secret, or choose a different algorithm."
msgstr ""
"HS256 ký mã bằng khoá bí mật làm khoá HMAC, nên khoá bí mật phải được lưu "
"dạng chưa băm. Hãy bỏ chọn “Băm khoá bí mật” và đặt khoá bí mật chưa băm, "
"hoặc chọn thuật toán khác."

#: oauth2_provider/forms.py
msgid ""
"HS256 requires an unhashed client secret. Uncheck this and set an unhashed "
"client secret, or choose a different algorithm."
msgstr ""
"HS256 cần khoá bí mật chưa băm. Hãy bỏ chọn mục này và đặt khoá bí mật chưa "
"băm, hoặc chọn thuật toán khác."

