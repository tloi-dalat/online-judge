#: reversion/templates/reversion/object_history.html
msgid ""
"Choose a date from the list below to revert to a previous version of this "
"object."
msgstr ""
"Chọn một thời điểm trong danh sách bên dưới để hoàn nguyên đối tượng này về "
"phiên bản trước."

#: reversion/templates/reversion/object_history.html
msgid ""
"This object doesn't have a change history. It probably wasn't added via this "
"admin site."
msgstr ""
"Đối tượng này không có lịch sử thay đổi. Có thể nó không được thêm qua trang "
"quản trị này."

#: reversion/templates/reversion/recover_form.html
msgid "Press the save button below to recover this version of the object."
msgstr "Bấm nút lưu bên dưới để khôi phục phiên bản này của đối tượng."

#: reversion/templates/reversion/recover_list.html
msgid ""
"Choose a date from the list below to recover a deleted version of an object."
msgstr ""
"Chọn một thời điểm trong danh sách bên dưới để khôi phục phiên bản đã xoá "
"của một đối tượng."

#: reversion/templates/reversion/recover_list.html
msgid "There are no deleted objects to recover."
msgstr "Không có đối tượng đã xoá nào để khôi phục."

