# Vietnamese translations of Django admin JavaScript strings that Django's own
# Vietnamese catalog doesn't cover yet. See django.po in this directory.
#
# Plural-Forms must match locale/vi/LC_MESSAGES/djangojs.po: the JavaScript
# catalog uses that rule for every string, so an entry with one form only (as in
# Django's own catalog) renders as an empty string whenever n != 1.
msgid ""
msgstr ""
"Project-Id-Version: Django overrides\n"
"PO-Revision-Date: 2026-10-11 00:00+0000\n"
"Last-Translator: \n"
"Language-Team: Vietnamese\n"
"Language: vi\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#: django/contrib/admin/static/admin/js/SelectFilter2.js
#, javascript-format
msgid ""
"Choose %s by selecting them and then select the \"Choose\" arrow button."
msgstr "Chọn %s bằng cách bấm vào chúng rồi bấm nút mũi tên \"Chọn\"."

#: django/contrib/admin/static/admin/js/SelectFilter2.js
#, javascript-format
msgid "Choose all %s"
msgstr "Chọn tất cả %s"

#: django/contrib/admin/static/admin/js/SelectFilter2.js
#, javascript-format
msgid "Choose selected %s"
msgstr "Chọn %s đã đánh dấu"

#: django/contrib/admin/static/admin/js/SelectFilter2.js
#, javascript-format
msgid "Remove selected %s"
msgstr "Bỏ %s đã đánh dấu"

#: django/contrib/admin/static/admin/js/SelectFilter2.js
#, javascript-format
msgid ""
"Remove %s by selecting them and then select the \"Remove\" arrow button."
msgstr "Bỏ %s bằng cách bấm vào chúng rồi bấm nút mũi tên \"Bỏ\"."

#: django/contrib/admin/static/admin/js/SelectFilter2.js
#, javascript-format
msgid "Type into this box to filter down the list of selected %s."
msgstr "Nhập vào ô này để lọc danh sách %s đã chọn."

#: django/contrib/admin/static/admin/js/SelectFilter2.js
msgid "(click to clear)"
msgstr "(bấm để xoá)"

#: django/contrib/admin/static/admin/js/SelectFilter2.js
#, javascript-format
msgid "Remove all %s"
msgstr "Bỏ tất cả %s"

#: django/contrib/admin/static/admin/js/SelectFilter2.js
#, javascript-format
msgid "%s selected option not visible"
msgid_plural "%s selected options not visible"
msgstr[0] "%s lựa chọn đã chọn đang bị ẩn"
msgstr[1] "%s lựa chọn đã chọn đang bị ẩn"

#: django/contrib/admin/static/admin/js/actions.js
msgid "%(sel)s of %(cnt)s selected"
msgid_plural "%(sel)s of %(cnt)s selected"
msgstr[0] "%(sel)s của %(cnt)s được chọn"
msgstr[1] "%(sel)s của %(cnt)s được chọn"

#: django/contrib/admin/static/admin/js/actions.js
msgid ""
"You have selected an action, and you haven’t made any changes on individual "
"fields. You’re probably looking for the Run button rather than the Save "
"button."
msgstr ""
"Bạn đã chọn một hành động nhưng chưa thay đổi trường nào. Có lẽ bạn cần bấm "
"nút Thực hiện thay vì nút Lưu."

